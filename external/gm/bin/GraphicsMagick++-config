#!/bin/sh
#
# Configure options script for re-calling compilation
# options required to use the Magick++ library.
#
# Concept derived from gtk-config in the Gtk package except that Autoconf-style
# configuration information is presented instead so that it may be used more
# effictively in configure scripts.
#
usage='Usage: GraphicsMagick++-config [--cppflags] [--cxxflags] [--exec-prefix] [--ldflags] [--libs] [--prefix] [--version]

 For example, "example.cpp" may be compiled to produce "example" as follows:

  "c++ -o example example.cpp `GraphicsMagick++-config --cppflags --cxxflags --ldflags --libs`"'

if test $# -eq 0; then
      echo "${usage}" 1>&2
      exit 1
fi

while test $# -gt 0; do
  case $1 in
    --prefix)
      echo /home/ubuntu/symros/external/gm
      ;;
    --exec-prefix)
      echo /home/ubuntu/symros/external/gm
      ;;
    --version)
      echo 1.4
      ;;
    --cppflags)
      echo '-I/home/ubuntu/symros/external/gm/include/GraphicsMagick'
      ;;
    --cxxflags)
      echo '-D_GNU_SOURCE -include /usr/include/semaphore.h -D_REENTRANT -stdlib=libc++ -pthread'
      ;;
    --ldflags)
      echo '-L/home/ubuntu/symros/external/gm/lib -pthread -L/usr/lib'
      ;;
    --libs)
      echo '-lGraphicsMagick++ -lGraphicsMagick -ljbig -llcms2 -ltiff -ljpeg -lpng16 -lXext -lSM -lICE -lX11 -llzma -lbz2 -lxml2 -lz -lm -lpthread'
      ;;
    *)
      echo "${usage}" 1>&2
      exit 1
      ;;
  esac
  shift
done

